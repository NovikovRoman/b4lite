[Unit]
Description=MTProto (Telegram) proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/mtproto-proxy -config /etc/mtproto-proxy/config.json
Restart=on-failure
RestartSec=2
User=nobody
Group=nogroup
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/mtproto-proxy

[Install]
WantedBy=multi-user.target
